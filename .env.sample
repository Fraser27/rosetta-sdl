# Neo4j connection — copy this file to .env and fill in your values.
# Existing shell environment variables take precedence over .env.
#
# CE is zero-config: leave these unset and each run path uses the right default
# (bolt://localhost:7687 for direct `uv run`, bolt://neo4j:7687 in docker-compose).
# A .env is only required for Aura.
#
# Community Edition (local) — only uncomment for a non-default CE setup:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=semantic-layer
#
# Neo4j AuraDB (hosted, 5.11+) — uncomment and use these:
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-aura-password
#
# AWS — required locally for Bedrock (NL queries + metric embeddings), Glue,
# Athena, and S3 Vectors. boto3 reads these automatically. On the EC2 deploy the
# instance role provides credentials via IMDS and the CDK injects
# AWS_DEFAULT_REGION explicitly, so these stay unset there.
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token   # only for temporary/SSO credentials
